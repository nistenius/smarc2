<launch>
  <!--Launch file for testing the INS -> ODOM, map_odom_initializer_node is used to define odom's fixed transform -->
  <arg name="robot_name" default="sam" />

  <!-- DECLARED, because sam_bringup.sh passes use_sim_time:=True and this file did not take it.
       An undeclared argument does not reach the node, so the health checker was the one process
       in the sim bringup still running on wall clock. That is not a cosmetic mismatch: topics
       published at their nominal rate in SIM time arrive slower than nominal in wall clock
       terms whenever Unity runs below real time, which reads here as a permanent rate fault,
       and a paused editor reads as an instant timeout. Either way health never reaches READY
       and wasp_bt refuses every start_tst, with nothing in the log pointing at the clock.
       Matches how sam_path_planning.launch and the diving controller launches do it. -->
  <arg name="use_sim_time" default="false" />

  <!-- Faults latch by default: on a real dive a sensor dropout means surface and investigate,
       not carry on because it came back. Sim bringups pass latch_faults:=False so that stopping
       and re-playing the Unity editor doesn't permanently poison mission acceptance. -->
  <arg name="latch_faults" default="True" />
  <arg name="recover_cycles" default="3" />
  <arg name="rate_tolerance" default="0.8" />
  <!-- Samples the rate is averaged over. At 5 (the long-standing value, kept as the default so
       hardware behaviour is unchanged) the window spans 0.17 s at 30 Hz, so a SINGLE late message
       reads as a 50% rate loss: a 0.20 s gap already faults, 0.30 s reads as 11 Hz. That cannot
       distinguish "the sensor died" from "one message was late". Sim bringups pass a larger
       value; whether hardware should too is a decision for the team, not for this default. -->
  <arg name="rate_window_size" default="5" />

  <node pkg="sam_health_checker" exec="sam_rate_health_node" name="sam_rate_health_node" output="screen" namespace="$(var robot_name)">
<!--     <param name="leak_topic" value="..." /> -->
<!--     <param name="battery_topic" value="..." /> -->
    <param name="battery_min_voltage" value="20.0" />
    <param name="battery_min_capacity" value="0.25" />

    <param name="initial_timeout_time_sec" value="60.0" />
    <param name="timeout_time_sec" value="7.5" />

    <param name="latch_faults" value="$(var latch_faults)" />
    <param name="recover_cycles" value="$(var recover_cycles)" />
    <param name="rate_tolerance" value="$(var rate_tolerance)" />
    <param name="rate_window_size" value="$(var rate_window_size)" />

    <param name="use_sim_time" value="$(var use_sim_time)" />

    <param name="verbose" value="True" />

  </node>

</launch>
