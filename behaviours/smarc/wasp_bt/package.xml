<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wasp_bt</name>
  <version>0.0.0</version>
  <description>The NEW Behaviour Tree for varius SMaRC vehicles, compatible with WARA-PS agent API specs. Usually wet.</description>
  <maintainer email="sdup@kth.se">Shekhar Devm Upadhyay</maintainer>
  <license>MIT</license>

  <exec_depend>py_trees</exec_depend>
  <exec_depend>py_trees_ros</exec_depend>
  <!-- Declared 2026-08-17 with A_SurfaceAndReport, which reads the GPS fix, the last
       commanded waypoint and the protective stop. These were already imported transitively
       through the action base; naming them is what makes a fresh workspace build in the
       right order instead of by luck. sam_farm_inspection is deliberately NOT here: the
       tree must come up on a hull with no farm code installed at all. -->
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>smarc_mission_msgs</exec_depend>
  <exec_depend>smarc_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
