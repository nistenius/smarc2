<launch>

    <!-- Cascaded-PID dive controller (Session C part 3, 2026-08-09).
         Cross-track ILOS -> heading -> yaw-rate; depth -> pitch -> pitch-rate;
         speed-nested VBS/LCG. Tuning: config/cascade_pid.yaml.
         SIM NOTE: rpm limits are unlocked here per Ivan (hardware caps stay in the
         stock launch/config): 800 -> 2500 rpm, measured k ~ 1300 rpm per m/s. -->
    <arg name="robot_name" default="sam0"/>
    <arg name="tf_suffix" default=""/>
    <arg name="use_sim_time" default="false"/>
    <arg name="dive_action_name" default="auv_depth_move_to"/>
    <arg name="control_yaml" default="$(find-pkg-share sam_diving_controller)/config/sam_diving_controller_config.yaml"/>
    <arg name="cascade_yaml" default="$(find-pkg-share sam_diving_controller)/config/cascade_pid.yaml"/>

    <group>
    <push-ros-namespace namespace="$(var robot_name)"/>
       <node name="diving_node" pkg="sam_diving_controller" exec="cascade_pid_wp_following" output="screen">
        <param name="robot_name" value="$(var robot_name)"/>
        <param name="tf_suffix" value="$(var tf_suffix)"/>
	<param from="$(var control_yaml)"/>
	<param from="$(var cascade_yaml)"/>
	<param name="use_sim_time" value="$(var use_sim_time)" />
	<param name="dive_action_name" value="$(var dive_action_name)" />
	<param name="target_frame" value="base_link" />
	<param name="distance_frame" value="base_link" />
	<param name="distance_frame_suffix" value="" />
	<param name="frame_suffix" value="" />
	<param name="setpoint_tolerance" value="0.3" />
        <param name="goal_threshold" value="9" />
       </node>
    </group>

</launch>
